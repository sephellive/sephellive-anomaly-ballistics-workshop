-- DXML invokes this entry point in every modxml_*.script during its own startup.
-- It must not be named on_game_start: that callback is only called for scripts
-- registered by Anomaly's autoload system.
function on_xml_read()
    printf("Sephellive ballistics workshop | xml hook loaded")
    RegisterScriptCallback("on_xml_read", function(xml_file_name, xml_obj)
        local menu_main = xml_obj:query("menu_main")[1]
        if not menu_main then
            return
        end

        if xml_obj:query("menu_main btn[name=btn_sep_ballistics_workshop]")[1] then
            return
        end

        printf("Sephellive ballistics workshop | injecting main-menu button into %s", xml_file_name)

        xml_obj:insertFromXMLString(
            [[<btn name="btn_sep_ballistics_workshop" caption="ui_mm_menu_test_fake_start" />]],
            menu_main,
            #menu_main.kids
        )
    end)
end
